# Godot 임포트 캐시 — .obj/.png 원본에서 언제든 재생성된다
.godot/

# 판정 산출물. screenshot.gd 가 --judge* 실행 때마다 다시 만든다(§7).
shots/

# §39 구운 메시. tools/bake_meshes.gd 가 원본 OBJ 에서 재생성한다(Vercel 빌드가 돌린다).
assets/baked/

# 웹 익스포트 결과물
build/

# 실행 로그
run.log
run.err

# Vercel 빌드가 Godot 에디터/템플릿을 풀어놓는 임시 디렉터리 (scripts/vercel-build.sh)
.godot-vercel/

# 로컬 판정용으로 내려받은 Godot 에디터 바이너리(171M) — 원본은 godotengine.org
.godot_engine/
